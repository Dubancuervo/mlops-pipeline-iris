{
  "contract_name": "iris_classifier_input",
  "contract_version": "1.0.0",
  "description": "Contrato de datos oficial para la inferencia del modelo RandomForest del Proyecto_Final_Grado, que clasifica flores Iris en tres especies a partir de 4 medidas en centímetros.",
  "model": {
    "name": "iris-random-forest",
    "task": "classification",
    "target": "target",
    "classes": [0, 1, 2],
    "class_labels": {"0": "setosa", "1": "versicolor", "2": "virginica"}
  },
  "rules": {
    "allow_null": false,
    "allow_extra_fields": false,
    "allow_missing_fields": false
  },
  "features": [
    {"name": "sepal_length_cm", "type": "float", "min": 4.0, "max": 8.5, "unit": "cm", "description": "Longitud del sépalo"},
    {"name": "sepal_width_cm",  "type": "float", "min": 1.5, "max": 5.0, "unit": "cm", "description": "Ancho del sépalo"},
    {"name": "petal_length_cm", "type": "float", "min": 0.5, "max": 7.5, "unit": "cm", "description": "Longitud del pétalo"},
    {"name": "petal_width_cm",  "type": "float", "min": 0.0, "max": 3.0, "unit": "cm", "description": "Ancho del pétalo"}
  ],
  "examples": {
    "valid": {
      "sepal_length_cm": 5.1,
      "sepal_width_cm": 3.5,
      "petal_length_cm": 1.4,
      "petal_width_cm": 0.2
    },
    "invalid": {
      "sepal_length_cm": "cinco",
      "sepal_width_cm": null,
      "petal_length_cm": 15.0,
      "petal_width_cm": 0.2
    },
    "invalid_expected_errors": [
      "sepal_length_cm: no se puede convertir 'cinco' a float",
      "sepal_width_cm: valor nulo no permitido",
      "petal_length_cm: valor 15.0 fuera de rango [0.5, 7.5]"
    ]
  }
}
